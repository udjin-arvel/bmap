# Neo4j (Bolt only inside the compose network)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# API auth
JWT_SECRET=change-me-jwt-secret-min-32-chars
EDITOR_KEY=change-me-editor-key
SEED_VIEWER_PASSWORD=viewer

# SQLite (path inside the api container; mounted volume recommended)
SQLITE_PATH=/data/app.db

# Optional: DeepSeek (stage 4)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Local Vite dev (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Published UI port on the host (docker compose web service)
WEB_PORT=8080
